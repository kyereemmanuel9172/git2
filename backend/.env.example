# PostgreSQL 16 database connection
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://cms_user:your_password@localhost:5432/church_db?schema=public"

# Redis (optional, for caching and rate limiting)
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT authentication
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="8h"

# Server configuration
NODE_ENV="development"
PORT=3002
FRONTEND_URL="http://localhost:3001"

# Logging
LOG_LEVEL="info"

# Swagger API docs (set to "true" to enable in production)
ENABLE_SWAGGER="false"

# --- Communication delivery providers ---

# Email (Resend API) — used for EMAIL campaigns.
# Sign up at https://resend.com and get your API key.
# Verify your domain in Resend dashboard, then set RESEND_FROM_EMAIL to an address on that domain.
RESEND_API_KEY=""       # Resend API key (starts with "re_")
RESEND_FROM_EMAIL=""    # Must be from a verified domain on Resend (e.g. noreply@yourchurch.com)
MAIL_FROM=""            # Fallback alias for RESEND_FROM_EMAIL

# SMS provider: twilio | africastalking | dev
#   twilio         -> uses TWILIO_* below
#   africastalking -> uses AT_* below (works in Ghana and across Africa)
#   dev            -> logs SMS to the console and marks them sent (no real SMS)
# Leave empty to auto-detect: Twilio, then Africa's Talking, then dev.
SMS_PROVIDER="dev"

# Twilio — used for SMS and programmatic voice calls.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""   # Twilio phone number for SMS (E.164, e.g. +15017122661)
TWILIO_CALL_FROM=""  # Twilio phone number for calls (E.164)

# Africa's Talking — SMS and voice calls (works in Ghana and across Africa).
# Sign up at https://africastalking.com and get your API key.
AT_USERNAME=""       # Your Africa's Talking username
AT_API_KEY=""        # Your Africa's Talking API key
AT_SMS_FROM=""       # Sender ID or shortcode (e.g. "ChurchApp")
AT_CALL_FROM=""      # Voice call sender ID (falls back to AT_SMS_FROM if empty)
