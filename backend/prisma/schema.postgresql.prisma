generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CHURCH_ADMIN
  SENIOR_PASTOR
  PASTOR
  FINANCE_OFFICER
  DEPARTMENT_LEADER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  VISITOR
  TRANSFERRED
  DECEASED
}

enum Gender {
  MALE
  FEMALE
}

enum ServiceType {
  SUNDAY
  MIDWEEK
  PRAYER
  EVENT
}

enum TransactionType {
  TITHE
  OFFERING
  DONATION
  EXPENSE
}

enum ContributionType {
  TITHE
  OFFERING
  SPECIAL
  PLEDGE
}

enum ContributionStatus {
  RECORDED
  VERIFIED
  VOID
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK
  CARD
  CHEQUE
  OTHER
}

enum PaymentStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
  VOID
}

enum PaymentSource {
  MANUAL
  PROVIDER
  IMPORT
}

enum EventStatus {
  DRAFT
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
}

enum PrayerStatus {
  OPEN
  IN_PROGRESS
  PRAYED_FOR
  CLOSED
}

enum CounselingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  FOLLOW_UP
}

enum AssetType {
  EQUIPMENT
  VEHICLE
  BUILDING
  FURNITURE
  OTHER
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  REPAIR_NEEDED
}

enum CommunicationType {
  SMS
  EMAIL
  CALL
}

enum CommunicationStatus {
  PENDING
  SENT
  PARTIAL
  FAILED
  CANCELLED
}

model Church {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  email        String?
  phone        String?
  country      String?
  city         String?
  address      String?
  website      String?
  currency     String   @default("USD")
  timezone     String   @default("UTC")
  brandColor   String   @default("#4f46e5")
  logoUrl      String?
  serviceTimes String?
  isActive     Boolean  @default(true)
  plan         String   @default("Starter")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users               User[]
  members             Member[]
  families            Family[]
  attendance          AttendanceRecord[]
  transactions        Transaction[]
  contributions       Contribution[]
  payments            Payment[]
  departments         Department[]
  events              ChurchEvent[]
  eventRegistrations  EventRegistration[]
  prayerRequests      PrayerRequest[]
  counselingSessions  CounselingSession[]
  assets              Asset[]
  campaigns           CommunicationCampaign[]
  announcements       Announcement[]
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  role               Role     @default(MEMBER)
  churchId           String?
  phone              String?
  avatar             String?
  twoFactorSecret    String?
  twoFactorEnabled   Boolean  @default(false)
  passwordResetToken String?
  passwordResetExpires DateTime?
  isActive           Boolean  @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  church             Church?               @relation(fields: [churchId], references: [id], onDelete: SetNull)
  auditLogs          AuditLog[]
  notifications      Notification[]
  counselsGiven      CounselingSession[] @relation("Counselor")
}

model Member {
  id               String       @id @default(cuid())
  firstName        String
  lastName         String
  email            String?
  phone            String?
  gender           Gender
  dateOfBirth      DateTime?
  address          String?
  city             String?
  maritalStatus    String?
  occupation       String?
  motherName       String?
  fatherName       String?
  churchBranch     String?
  membershipStatus MemberStatus @default(ACTIVE)
  joinDate         DateTime?
  baptismDate      DateTime?
  qrCode           String?
  memberId         String?
  photoUrl         String?
  familyId         String?
  churchId         String
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  church           Church?               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  family           Family?               @relation("FamilyMembers", fields: [familyId], references: [id], onDelete: SetNull)
  headedFamilies   Family[]              @relation("FamilyHead")
  attendance       AttendanceRecord[]
  transactions     Transaction[]
  contributions    Contribution[]
  payments         Payment[]
  departmentLinks  MemberDepartment[]
  eventRegistrations EventRegistration[]
  prayerRequests   PrayerRequest[]
  counselingSessions CounselingSession[]

  @@index([firstName, lastName])
  @@index([familyId])
  @@index([churchId])
  @@unique([churchId, memberId])
}

model Family {
  id           String   @id @default(cuid())
  name         String
  address      String?
  headMemberId String?  @unique
  churchId     String
  createdAt    DateTime @default(now())

  church   Church?  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  members  Member[] @relation("FamilyMembers")
  head     Member?  @relation("FamilyHead", fields: [headMemberId], references: [id])

  @@index([churchId])
}

model AttendanceRecord {
  id         String      @id @default(cuid())
  memberId   String
  churchId   String
  serviceType ServiceType
  date       DateTime    @default(now())
  checkedInAt DateTime   @default(now())
  checkedInBy String?
  notes      String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([serviceType, date])
  @@index([churchId, date])
  @@unique([memberId, serviceType, date])
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("USD")
  category    String?
  description String?
  date        DateTime        @default(now())
  memberId    String?
  churchId    String
  recordedBy  String?
  createdAt   DateTime        @default(now())

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  church Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([type, date])
  @@index([memberId])
  @@index([churchId])
}

model Contribution {
  id         String             @id @default(cuid())
  type       ContributionType
  amount     Decimal            @db.Decimal(12, 2)
  currency   String             @default("USD")
  method     PaymentMethod      @default(CASH)
  status     ContributionStatus @default(RECORDED)
  memberId   String?
  giverName  String?
  service    String?
  date       DateTime           @default(now())
  reference  String?
  notes      String?
  recordedBy String?
  churchId   String
  createdAt  DateTime           @default(now())

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  church Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([type, date])
  @@index([status])
  @@index([memberId])
  @@index([churchId])
}

model Payment {
  id         String        @id @default(cuid())
  amount     Decimal       @db.Decimal(12, 2)
  currency   String        @default("USD")
  payerName  String?
  category   String?
  method     PaymentMethod @default(CASH)
  status     PaymentStatus @default(COMPLETED)
  source     PaymentSource @default(MANUAL)
  memberId   String?
  date       DateTime      @default(now())
  reference  String?
  notes      String?
  recordedBy String?
  churchId   String
  createdAt  DateTime      @default(now())

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  church Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([status, date])
  @@index([memberId])
  @@index([churchId])
}

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  leaderId    String?
  churchId    String
  createdAt   DateTime @default(now())

  church  Church             @relation(fields: [churchId], references: [id], onDelete: Cascade)
  members MemberDepartment[]
  announcements Announcement[]

  @@unique([churchId, name])
  @@index([churchId])
}

model MemberDepartment {
  id           String     @id @default(cuid())
  departmentId String
  memberId     String
  role         String?    @default("Member")
  joinedAt     DateTime   @default(now())

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([departmentId, memberId])
}

model ChurchEvent {
  id           String      @id @default(cuid())
  title        String
  description  String?
  type         String      @default("General")
  location     String?
  startDate    DateTime
  endDate      DateTime?
  capacity     Int?
  status       EventStatus @default(UPCOMING)
  churchId     String
  createdAt    DateTime    @default(now())

  church       Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@index([churchId])
}

model EventRegistration {
  id           String             @id @default(cuid())
  eventId      String
  memberId     String
  churchId     String
  status       RegistrationStatus @default(CONFIRMED)
  attended     Boolean            @default(false)
  registeredAt DateTime           @default(now())

  event  ChurchEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  church Church      @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId])
  @@unique([eventId, memberId])
}

model PrayerRequest {
  id          String       @id @default(cuid())
  memberId    String?
  churchId    String
  subject     String
  content     String
  isPublic    Boolean      @default(true)
  status      PrayerStatus @default(OPEN)
  prayedForAt DateTime?
  prayedBy    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  church Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId])
}

model CounselingSession {
  id           String             @id @default(cuid())
  memberId     String
  counselorId  String?
  churchId     String
  date         DateTime
  topic        String
  notes        String?
  followUpDate DateTime?
  status       CounselingStatus   @default(SCHEDULED)
  createdAt    DateTime           @default(now())

  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  counselor User?   @relation("Counselor", fields: [counselorId], references: [id], onDelete: SetNull)
  church    Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId])
}

model Asset {
  id            String          @id @default(cuid())
  name          String
  type          AssetType       @default(EQUIPMENT)
  serialNumber  String?
  condition     AssetCondition  @default(GOOD)
  purchaseDate  DateTime?
  purchasePrice Decimal?        @db.Decimal(12, 2)
  location      String?
  assignedTo    String?
  notes         String?
  churchId      String
  createdAt     DateTime        @default(now())

  church      Church             @relation(fields: [churchId], references: [id], onDelete: Cascade)
  maintenance AssetMaintenance[]

  @@index([churchId])
}

model AssetMaintenance {
  id          String   @id @default(cuid())
  assetId     String
  date        DateTime @default(now())
  description String
  cost        Decimal? @db.Decimal(12, 2)
  performedBy String?
  nextDueDate DateTime?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model CommunicationCampaign {
  id              String               @id @default(cuid())
  type            CommunicationType
  subject         String?
  message         String
  memberStatus    String?
  departmentId    String?
  gender          String?
  city            String?
  status          CommunicationStatus  @default(PENDING)
  totalRecipients Int                  @default(0)
  sentCount       Int                  @default(0)
  failedCount     Int                  @default(0)
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdBy       String?
  churchId        String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  church   Church                 @relation(fields: [churchId], references: [id], onDelete: Cascade)
  messages CommunicationMessage[]

  @@index([status, scheduledAt])
  @@index([type])
  @@index([churchId])
}

model CommunicationMessage {
  id         String             @id @default(cuid())
  campaignId String
  memberId   String
  channel    CommunicationType
  status     String             @default("QUEUED")
  error      String?
  sentAt     DateTime?
  createdAt  DateTime           @default(now())

  campaign CommunicationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model Announcement {
  id           String            @id @default(cuid())
  title        String
  content      String
  departmentId String?
  memberStatus String?
  gender       String?
  city         String?
  status       AnnouncementStatus @default(DRAFT)
  publishedAt  DateTime?
  createdBy    String?
  churchId     String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  church     Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([churchId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
